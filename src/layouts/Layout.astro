---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Spartan Mobile Tyres",
  description = "Mobile tyre fitting in Staines-upon-Thames and Surrey. New tyres, puncture repairs and wheel balancing — we come to you.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteOrigin = "https://spartanmobiletyres.com";
const ogImage = `${siteOrigin}/img/logo.jpg`;

const nav = [
  { href: base, label: "Home" },
  { href: `${base}services/`, label: "Services" },
  { href: `${base}contact/`, label: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href={`${base}img/logo-icon.jpg`} />
    <link rel="apple-touch-icon" href={`${base}img/logo-icon.jpg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Spartan Mobile Tyres" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href={base} class="brand">
          <img src={`${base}img/logo-icon.jpg`} alt="Spartan Mobile Tyres logo" width="42" height="42" />
          <span class="brand-name">Spartan <span>Mobile</span> Tyres</span>
        </a>
        <nav class="nav">
          {nav.map(n => <a href={n.href}>{n.label}</a>)}
          <a href={`${base}contact/`} class="nav-cta">Book Now</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand-block">
            <div class="footer-logo">
              <img src={`${base}img/logo-icon.jpg`} alt="Spartan Mobile Tyres" width="40" height="40" />
              <span class="footer-logo-name">Spartan <span>Mobile</span> Tyres</span>
            </div>
            <p class="footer-tagline">Mobile tyre fitting across Staines-upon-Thames and Surrey. We come to you — at home, at work, or wherever you're parked.</p>
          </div>
          <div class="footer-col">
            <h4>Services</h4>
            <ul>
              <li><a href={`${base}services/`}>Services &amp; Pricing</a></li>
              <li><a href={`${base}services/#areas`}>Service Areas</a></li>
              <li><a href={`${base}contact/`}>Book a Fitting</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Contact</h4>
            <ul>
              <li><a href="tel:+447511928899">07511 928899</a></li>
              <li><a href="https://wa.me/447511928899" target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href="https://www.tiktok.com/@beanz377" target="_blank" rel="noopener">TikTok</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} Spartan Mobile Tyres. All rights reserved.</span>
          <span>Staines-upon-Thames, Surrey</span>
        </div>
      </div>
    </footer>

    <a
      href="https://wa.me/447511928899?text=Hi%2C%20I%27d%20like%20to%20book%20a%20mobile%20tyre%20fitting"
      class="wa-fab"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Book via WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
      <span>Book via WhatsApp</span>
    </a>
  </body>
</html>
