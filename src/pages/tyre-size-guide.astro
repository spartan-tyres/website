---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;

const parts = [
  {
    label: "225",
    name: "Section Width",
    color: "#b32424",
    desc: "The width of the tyre in millimetres from sidewall to sidewall. A wider tyre gives more grip but uses more fuel.",
  },
  {
    label: "45",
    name: "Aspect Ratio",
    color: "#c0392b",
    desc: "The height of the sidewall as a percentage of the section width. Lower numbers mean a stiffer, sportier ride.",
  },
  {
    label: "R",
    name: "Construction",
    color: "#444",
    desc: "R stands for Radial, the standard construction on almost every modern car tyre. The internal cords run radially from bead to bead.",
  },
  {
    label: "17",
    name: "Rim Diameter",
    color: "#222",
    desc: "The diameter of the wheel rim in inches that this tyre fits. This must match your wheel exactly.",
  },
  {
    label: "91",
    name: "Load Index",
    color: "#555",
    desc: "A code for the maximum load the tyre can carry. 91 = 615 kg per tyre. Never fit a tyre with a lower load index than your vehicle requires.",
  },
  {
    label: "W",
    name: "Speed Rating",
    color: "#888",
    desc: "The maximum sustained speed the tyre is designed for. W = 270 km/h (168 mph). Must meet or exceed the car manufacturer's minimum.",
  },
];

const locations = [
  "Printed on the sidewall of any current tyre",
  "Inside the driver's door jamb (sticker)",
  "Your vehicle handbook / owner's manual",
  "The fuel filler flap on some models",
];
---

<Layout
  title="Tyre Size Guide | Spartan Tyres"
  description="Confused by tyre size numbers? Our simple guide explains what 225/45 R17 91W means: width, aspect ratio, rim size and more. Serving Staines-upon-Thames and Surrey."
>
  <section class="hero" style="padding: 3.5rem 0 2.5rem;">
    <div class="container">
      <span class="eyebrow">Quick reference</span>
      <h1>How to read a tyre size</h1>
      <p>Those numbers on your tyre sidewall aren't cryptic. Here's exactly what each one means.</p>
    </div>
  </section>

  <section>
    <div class="container">

      <div class="size-display card">
        <p class="size-label">Example tyre size</p>
        <div class="size-strip" aria-label="Tyre size 225 slash 45 R 17 91 W">
          {parts.map((p) => (
            <span class="size-seg" style={`background: ${p.color};`}>
              {p.label}
            </span>
          ))}
        </div>
        <div class="size-raw">225 / 45 R17 91W</div>
      </div>

      <div class="parts-grid">
        {parts.map((p) => (
          <div class="card part-card">
            <div class="part-chip" style={`background: ${p.color};`}>{p.label}</div>
            <div>
              <h3 class="part-name">{p.name}</h3>
              <p class="part-desc">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="find-size card">
        <h2>Where to find your tyre size</h2>
        <ul class="find-list">
          {locations.map((loc) => (
            <li>
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 10 8 14 16 6"/></svg>
              {loc}
            </li>
          ))}
        </ul>
        <p class="find-note">Not sure which size you need? Just send us a photo of your tyre sidewall and we'll sort it for you.</p>
      </div>

      <div class="guide-cta card">
        <h3>Need a new tyre or a puncture repair?</h3>
        <p>Tell us your tyre size and we'll confirm it's in stock and give you a straight price with no hidden fees.</p>
        <a class="btn" href={`${base}contact/`}>Get a quote</a>
      </div>

    </div>
  </section>
</Layout>

<style>
  .size-display {
    text-align: center;
    padding: 2rem;
    margin-bottom: 2.5rem;
  }
  .size-label {
    font-size: 0.85rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1rem;
  }
  .size-strip {
    display: inline-flex;
    align-items: stretch;
    border-radius: 8px;
    overflow: hidden;
    font-size: clamp(1.4rem, 4vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    gap: 2px;
  }
  .size-seg {
    display: inline-flex;
    align-items: center;
    padding: 0.6em 0.75em;
    color: #fff;
  }
  .size-raw {
    margin-top: 1rem;
    font-size: 1rem;
    color: var(--muted);
    font-family: monospace;
    letter-spacing: 0.05em;
  }

  .parts-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-bottom: 2.5rem;
  }

  .part-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .part-chip {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
  }
  .part-name {
    font-size: 1rem;
    margin: 0 0 0.3rem;
  }
  .part-desc {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.55;
  }

  .find-size {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }
  .find-size h2 { margin-bottom: 1rem; }
  .find-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.6rem;
  }
  .find-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
  }
  .find-list svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--accent);
  }
  .find-note {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
    border-top: 1px solid var(--border);
    padding-top: 0.85rem;
  }

  .guide-cta {
    max-width: 32rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .guide-cta h3 { margin-bottom: 0; }
  .guide-cta p { margin: 0; }
  .guide-cta .btn { margin-top: 0.5rem; align-self: flex-start; }
</style>
