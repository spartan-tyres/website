---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Spartan Mobile Tyres | Staines-upon-Thames & Surrey" description="Mobile tyre fitting in Staines-upon-Thames and Surrey. New tyres, puncture repairs and wheel balancing — we come to you at home or work.">

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-text">
          <span class="hero-tag">Mobile Tyre Fitting</span>
          <h1>We come to <em>you</em>.</h1>
          <p>New tyres, puncture repairs and wheel balancing across Staines-upon-Thames and Surrey. No forecourt, no waiting — we fit at your home or workplace.</p>
          <div class="hero-btns">
            <a href={`${base}contact/`} class="btn btn-primary">Book a Fitting</a>
            <a
              href="https://wa.me/447511928899?text=Hi%2C%20I%27d%20like%20to%20book%20a%20mobile%20tyre%20fitting"
              class="btn btn-outline"
              target="_blank" rel="noopener"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              WhatsApp Us
            </a>
          </div>
        </div>
        <div class="hero-image">
          <img src={`${base}img/logo.jpg`} alt="Spartan Mobile Tyres" width="340" height="340" />
          <div class="hero-badge">
            <span class="dot"></span>
            Available now &mdash; 7 days a week
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <div class="stats-bar">
    <div class="container">
      <div class="stats-inner">
        <div class="stat">
          <div class="stat-num">30min</div>
          <div class="stat-label">Average fitting time</div>
        </div>
        <div class="stat">
          <div class="stat-num">7</div>
          <div class="stat-label">Days a week</div>
        </div>
        <div class="stat">
          <div class="stat-num">8+</div>
          <div class="stat-label">Areas covered</div>
        </div>
        <div class="stat">
          <div class="stat-num">5★</div>
          <div class="stat-label">Google rated</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Services -->
  <section>
    <div class="container">
      <div class="section-head">
        <p class="section-label">What we do</p>
        <h2>Our Services</h2>
        <p>Everything tyre-related, carried out at your location. No garage visit needed.</p>
      </div>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3>New Tyres</h3>
          <p>Budget, mid-range and premium brands fitted at your door. We carry stock and order to suit your car.</p>
          <div class="service-price">From competitive prices</div>
        </div>
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Puncture Repair</h3>
          <p>Flat tyre? We'll come to you, assess it and repair or replace on the spot. Fast turnaround.</p>
          <div class="service-price">Quick response</div>
        </div>
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>Wheel Balancing</h3>
          <p>Vibration or uneven wear? We balance your wheels on-site to smooth out the ride and extend tyre life.</p>
          <div class="service-price">On-site service</div>
        </div>
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3>TPMS Service</h3>
          <p>Tyre pressure warning light on? We diagnose, replace sensors and reset your TPMS system.</p>
          <div class="service-price">Full diagnostics</div>
        </div>
      </div>
      <div style="margin-top: 2rem;">
        <a href={`${base}services/`} class="btn btn-outline">View all services &amp; pricing</a>
      </div>
    </div>
  </section>

  <!-- Areas -->
  <section class="areas-section" id="areas">
    <div class="container">
      <div class="section-head">
        <p class="section-label">Where we work</p>
        <h2>Service Areas</h2>
        <p>Based in Staines-upon-Thames, covering the wider Surrey area. Not on the list? Get in touch anyway.</p>
      </div>
      <div class="areas-grid">
        {[
          { name: "Staines-upon-Thames", pc: "TW18/TW19" },
          { name: "Ashford", pc: "TW15" },
          { name: "Egham", pc: "TW20" },
          { name: "Shepperton", pc: "TW17" },
          { name: "Sunbury-on-Thames", pc: "TW16" },
          { name: "Weybridge", pc: "KT13" },
          { name: "Chertsey", pc: "KT16" },
          { name: "Feltham", pc: "TW13/TW14" },
        ].map(a => (
          <div class="area-chip">
            <span class="area-name">{a.name}</span>
            <span class="area-pc">{a.pc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section>
    <div class="container">
      <div class="section-head">
        <p class="section-label">Why choose us</p>
        <h2>The Spartan difference</h2>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-num">01</div>
          <h3>We come to you</h3>
          <p>No need to drive to a garage. We fit at your home, office or wherever the car is parked.</p>
        </div>
        <div class="why-card">
          <div class="why-num">02</div>
          <h3>Honest pricing</h3>
          <p>Straight prices, no hidden fees. You know exactly what you're paying before we arrive.</p>
        </div>
        <div class="why-card">
          <div class="why-num">03</div>
          <h3>7 days a week</h3>
          <p>Available every day including weekends and bank holidays. Book when it suits you.</p>
        </div>
        <div class="why-card">
          <div class="why-num">04</div>
          <h3>Done in 30 minutes</h3>
          <p>Most jobs are complete in under half an hour. In and out with minimal disruption.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to book?</h2>
      <p>Tell us your tyre size and location and we'll get you sorted. Most bookings confirmed the same day.</p>
      <div class="cta-btns">
        <a href={`${base}contact/`} class="btn btn-primary">Book a Fitting</a>
        <a
          href="https://wa.me/447511928899?text=Hi%2C%20I%27d%20like%20to%20book%20a%20mobile%20tyre%20fitting"
          class="btn btn-outline"
          target="_blank" rel="noopener"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          WhatsApp Us
        </a>
        <a href="tel:+447511928899" class="btn btn-outline">Call 07511 928899</a>
      </div>
    </div>
  </section>

</Layout>
