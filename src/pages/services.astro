---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Services & Pricing | Spartan Mobile Tyres" description="Mobile tyre fitting, puncture repairs, wheel balancing and TPMS across Staines-upon-Thames and Surrey. Transparent prices, no hidden fees.">

  <section style="padding: 4rem 0 3rem; background: radial-gradient(ellipse 60% 50% at 80% 0%, rgba(255,102,0,0.15) 0%, transparent 60%), var(--bg);">
    <div class="container">
      <p class="section-label">What we offer</p>
      <h1>Services &amp; Pricing</h1>
      <p style="color: var(--muted); font-size: 1.05rem; max-width: 34rem; margin-top: 0.75rem;">Every job carried out at your location. Prices confirmed before we arrive — no surprises.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <p class="section-label">Core services</p>
        <h2>What we fit and fix</h2>
      </div>
      <div class="services-detail-grid">

        <div class="service-detail-card">
          <div class="sdc-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <div>
            <h3>New Tyres</h3>
            <p>We carry a wide range of budget, mid-range and premium tyres. Tell us your tyre size and we'll confirm what's in stock with a straight price. Brands we stock include Michelin, Pirelli, Continental, Goodyear, Bridgestone and more.</p>
            <ul class="service-list">
              <li>All sizes available</li>
              <li>Budget to premium brands</li>
              <li>Fitted at your location</li>
              <li>Old tyres disposed of responsibly</li>
            </ul>
          </div>
        </div>

        <div class="service-detail-card">
          <div class="sdc-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div>
            <h3>Puncture Repair</h3>
            <p>Got a flat or a slow puncture? We come to you and assess whether a repair or replacement is the right call. We'll always be honest with you about what's needed.</p>
            <ul class="service-list">
              <li>Fast response across our service area</li>
              <li>Repair or replace on the spot</li>
              <li>Honest assessment</li>
            </ul>
          </div>
        </div>

        <div class="service-detail-card">
          <div class="sdc-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div>
            <h3>Wheel Balancing</h3>
            <p>Vibration through the steering wheel or uneven tyre wear often means your wheels are out of balance. We balance on-site using professional equipment for a smoother, safer ride.</p>
            <ul class="service-list">
              <li>On-site balancing</li>
              <li>Reduces vibration and wear</li>
              <li>Extends tyre life</li>
            </ul>
          </div>
        </div>

        <div class="service-detail-card">
          <div class="sdc-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <div>
            <h3>TPMS (Tyre Pressure Sensors)</h3>
            <p>Tyre pressure warning light on? We diagnose and replace faulty sensors and reset your TPMS system. Essential if you're fitting new tyres on a modern car.</p>
            <ul class="service-list">
              <li>Sensor replacement</li>
              <li>System reset</li>
              <li>All makes supported</li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section style="background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
    <div class="container">
      <div class="section-head">
        <p class="section-label">Areas covered</p>
        <h2 id="areas">Where we work</h2>
        <p>Based in Staines-upon-Thames, we cover the following areas. Not on the list? Drop us a message.</p>
      </div>
      <div class="areas-grid">
        {[
          { name: "Staines-upon-Thames", pc: "TW18/TW19" },
          { name: "Ashford", pc: "TW15" },
          { name: "Egham", pc: "TW20" },
          { name: "Shepperton", pc: "TW17" },
          { name: "Sunbury-on-Thames", pc: "TW16" },
          { name: "Weybridge", pc: "KT13" },
          { name: "Chertsey", pc: "KT16" },
          { name: "Feltham", pc: "TW13/TW14" },
        ].map(a => (
          <div class="area-chip">
            <span class="area-name">{a.name}</span>
            <span class="area-pc">{a.pc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Get a quote</h2>
      <p>Tell us your tyre size and we'll confirm it's in stock with a straight price. No hidden charges.</p>
      <div class="cta-btns">
        <a href={`${base}contact/`} class="btn btn-primary">Book a Fitting</a>
        <a href="https://wa.me/447511928899?text=Hi%2C%20I%27d%20like%20a%20tyre%20quote" class="btn btn-outline" target="_blank" rel="noopener">WhatsApp for a quote</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .services-detail-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
  .service-detail-card {
    display: flex; gap: 1.25rem; align-items: flex-start;
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.75rem;
    transition: border-color 0.2s;
  }
  .service-detail-card:hover { border-color: rgba(255,102,0,0.4); }
  .sdc-icon {
    flex-shrink: 0; width: 52px; height: 52px; border-radius: 12px;
    background: rgba(255,102,0,0.12); border: 1px solid rgba(255,102,0,0.2);
    display: flex; align-items: center; justify-content: center; color: var(--orange);
  }
  .service-detail-card h3 { margin-bottom: 0.5rem; }
  .service-detail-card p { color: var(--muted); font-size: 0.9rem; margin-bottom: 1rem; }
  .service-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
  .service-list li { font-size: 0.875rem; color: var(--muted); padding-left: 1.25rem; position: relative; }
  .service-list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 6px; height: 6px; border-radius: 50%; background: var(--orange); }
</style>
